{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stayworth",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client"
  },
  "routes": [
    { "pattern": "stayworth.top", "custom_domain": true },
    { "pattern": "www.stayworth.top", "custom_domain": true }
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stayworth-mvp",
      "database_id": "1a00af70-d19c-4ec8-99e1-9165a398ca67",
      "migrations_dir": "drizzle"
    }
  ]
}
